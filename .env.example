# ============================================================
# CATATAN MUROJAAH — contoh konfigurasi lingkungan
# Salin berkas ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah meng-commit berkas `.env` yang berisi nilai asli.
# (`.gitignore` sudah mengecualikan `.env` dan `.env.*`)
# ============================================================

# --- WAJIB untuk mode web (server menolak start tanpa ini) ---

# Mode aplikasi. Nilai "web" = hosting/publik; tanpa ini aplikasi jalan
# di mode lokal (bind 127.0.0.1).
CATATAN_MODE=web

# Kunci tanda tangan cookie sesi. Isi dengan string acak panjang, contoh:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CATATAN_RAHASIA=

# Sandi pemilik (pilih salah satu):
#   - sandi polos (string acak panjang), atau
#   - hash SHA-256 heksadesimal dari sandi (lebih aman, disarankan).
CATATAN_OWNER_SANDI=
# CATATAN_OWNER_SANDI_SHA256=

# --- Opsional ---

# Port listen. Di platform hosting biasanya disuntikkan otomatis.
PORT=8080

# Pengalihan folder penyimpanan runtime (bawaan: ./data-rw).
# CATATAN_RW_DIR=

# Anggaran harian permintaan AI (bawaan aman 200/hari; 0 = tanpa batas,
# hanya untuk pemakaian pribadi).
# CATATAN_AI_HARIAN=200

# Batas potongan transkrip per sesi (bawaan 40).
# CATATAN_TRANSKRIP_MAKS=40

# --- Kunci layanan AI (kompatibel OpenAI) ---
# Cara utama: pasang kunci lewat halaman /panel setelah server berjalan
# (tersimpan di toko runtime server, tidak pernah masuk repo/log).
# Env di bawah hanya fallback bila platform menyediakan env secret resmi.
# JANGAN mengisi berkas ini dengan kunci asli — kunci asli hanya di `.env`
# lokal yang tidak di-commit.
CATATAN_AI_KEY=
# Basis endpoint kompatibel OpenAI (bawaan layanan SumoPod).
# CATATAN_AI_BASE=
# Nama model, contoh: openai/gpt-4o-mini
# CATATAN_AI_MODEL=

# --- Mode lokal / pengembangan ---

# =1 : jangan membuka browser otomatis saat server lokal start.
# CATATAN_TANPA_BROWSER=1

# =1 : mengizinkan pemanggilan model bahasa sungguhan oleh planner
# (gerbang aman; tanpa ini planner hanya memakai backend stub lokal).
# CATATAN_MUROJAAH_IZINKAN_LLM=1

# Kredensial backend LLM untuk planner.py (LLMPlanner) — hanya dipakai
# bila pengizin di atas bernilai 1. Tanpa ini, StubPlanner lokal dipakai.
# TUNTAS_LLM_URL=
# TUNTAS_LLM_KEY=
# TUNTAS_LLM_MODEL=

# Khusus pengujian: daftar tipe adaptor yang disimulasikan gagal (CSV).
# TUNTAS_FAIL_ADAPTER=email,calendar
